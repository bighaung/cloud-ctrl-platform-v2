# ── Database ──────────────────────────────────────────────────
DB_USER=admin
DB_PASS=your_strong_password_here
DATABASE_URL=postgresql://admin:your_strong_password_here@localhost:5432/aliyun_ctrl

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASS=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@localhost:6379

# ── JWT Auth ───────────────────────────────────────────────────
# 用以下指令生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=8h

# ── Aliyun 主帳號 RAM (用於 AssumeRole) ───────────────────────
# 建立一個專用 RAM 用戶，只賦予 AssumeRole 權限
ALIYUN_MASTER_ACCESS_KEY_ID=LTAI5t...
ALIYUN_MASTER_ACCESS_KEY_SECRET=...

# ── App ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── 初始管理員帳號 (首次啟動自動建立) ─────────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_on_first_login
